# Copy this file to .env and fill in the values.
# Save this file as UTF-8. Avoid non-ASCII comments: load_dotenv() reads UTF-8,
# but `langgraph dev` reads .env with the OS locale encoding (cp949 on Korean
# Windows), so a Korean comment can break server startup. PYTHONUTF8=1 also fixes it.

OPENAI_API_KEY=

# Optional. Point this at any OpenAI-compatible chat endpoint (self-hosted
# vLLM / Ollama / gateway). Leave empty to use the official OpenAI API.
# The book describes the official API; only this line changes for others.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-luna

# Langfuse - pick a region and stick with it (accounts are region-scoped)
#   JP: https://jp.cloud.langfuse.com
#   US: https://us.cloud.langfuse.com
#   EU: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
